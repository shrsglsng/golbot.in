# =================================
# ENVIRONMENT CONFIGURATION TEMPLATES
# =================================

# This file contains templates for different environment combinations.
# Copy the relevant section to your .env files based on your needs.

# =================================
# 1. TEST USER WEB + TEST SERVER
# =================================

# Server .env:
PAYMENT_GATEWAY=phonepe
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=TEST-M22FF46UFCGI7_25102
PHONEPE_CLIENT_SECRET=MjYxMjI2N2EtYjM0Ny00OWFjLWEwOGUtZmQzNmI4N2I2M2Rl
PHONEPE_REDIRECT_URL=http://localhost:3000/payment/redirect
NODE_ENV=development

# User Web .env.local:
NEXT_PUBLIC_SERVER_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_PAYMENT_GATEWAY=phonepe
NEXT_PUBLIC_PHONEPE_ENV=sandbox
NEXT_PUBLIC_ENVIRONMENT=development

# =================================
# 2. TEST USER WEB + PROD SERVER
# =================================

# Server .env:
PAYMENT_GATEWAY=phonepe
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=TEST-M22FF46UFCGI7_25102
PHONEPE_CLIENT_SECRET=MjYxMjI2N2EtYjM0Ny00OWFjLWEwOGUtZmQzNmI4N2I2M2Rl
PHONEPE_REDIRECT_URL=https://yourdomain.com/payment/redirect
NODE_ENV=production

# User Web .env.local:
NEXT_PUBLIC_SERVER_URL=https://your-prod-server.com/api/v1
NEXT_PUBLIC_PAYMENT_GATEWAY=phonepe
NEXT_PUBLIC_PHONEPE_ENV=sandbox
NEXT_PUBLIC_ENVIRONMENT=development

# =================================
# 3. PROD USER WEB + TEST SERVER
# =================================

# Server .env:
PAYMENT_GATEWAY=phonepe
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=TEST-M22FF46UFCGI7_25102
PHONEPE_CLIENT_SECRET=MjYxMjI2N2EtYjM0Ny00OWFjLWEwOGUtZmQzNmI4N2I2M2Rl
PHONEPE_REDIRECT_URL=http://localhost:3000/payment/redirect
NODE_ENV=development

# User Web .env.local:
NEXT_PUBLIC_SERVER_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_PAYMENT_GATEWAY=phonepe
NEXT_PUBLIC_PHONEPE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=production

# =================================
# 4. PROD USER WEB + PROD SERVER
# =================================

# Server .env:
PAYMENT_GATEWAY=phonepe
PHONEPE_ENV=production
PHONEPE_CLIENT_ID=your_production_client_id
PHONEPE_CLIENT_SECRET=your_production_client_secret
PHONEPE_REDIRECT_URL=https://yourdomain.com/payment/redirect
NODE_ENV=production

# User Web .env.local:
NEXT_PUBLIC_SERVER_URL=https://your-prod-server.com/api/v1
NEXT_PUBLIC_PAYMENT_GATEWAY=phonepe
NEXT_PUBLIC_PHONEPE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=production

# =================================
# FALLBACK TO RAZORPAY (IF NEEDED)
# =================================

# To switch back to Razorpay temporarily:
# Server .env:
PAYMENT_GATEWAY=razorpay
ALLOW_RAZORPAY=true
ALLOW_PHONEPE=false

# User Web .env.local:
NEXT_PUBLIC_PAYMENT_GATEWAY=razorpay

# =================================
# WEBHOOK CONFIGURATION
# =================================

# For PhonePe webhooks, configure these URLs in PhonePe merchant dashboard:
# Test: http://your-ngrok-url.ngrok.io/api/v1/phonepe/webhook
# Prod: https://yourdomain.com/api/v1/phonepe/webhook

# Set webhook authentication:
PHONEPE_WEBHOOK_USER=your_webhook_user
PHONEPE_WEBHOOK_PASS=your_webhook_password
PHONEPE_WEBHOOK_STRICT=true  # Set to true in production

# Enable/disable demo mode
DEMO_MODE=true

# Demo credentials (used when DEMO_MODE=true)
DEMO_PHONE=9876543210
DEMO_OTP=123456