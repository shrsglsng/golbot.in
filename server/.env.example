# =================================
# GOLBOT SERVER CONFIGURATION
# =================================
# Available environments: local, stage, prod
# Use: npm run start:local / npm run start:stage / npm run start:prod

# =================================
# ENVIRONMENT-SPECIFIC CONFIGURATION
# =================================
# These settings change between local/stage/prod

# Environment
NODE_ENV=local

# Frontend URLs (used to auto-construct CORS, payment redirects, and QR codes)
# local: http://localhost:3000 / http://localhost:3001
# stage: https://stage.golbot.in / https://admin-stage.golbot.in
# prod:  https://golbot.in / https://admin.golbot.in
USER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

# Additional CORS origins (optional, comma-separated)
# Only needed if you have extra domains beyond USER_WEB_URL and ADMIN_WEB_URL
# CORS_ORIGIN=https://extra-domain.com,https://another-domain.com

# =================================
# SERVER CONFIGURATION
# =================================

# Database Configuration
# local: mongodb+srv://user:pass@cluster.mongodb.net/local
# stage: mongodb+srv://user:pass@cluster.mongodb.net/stage
# prod:  mongodb+srv://user:pass@cluster.mongodb.net/prod
EXPAPP_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/database

# Server Configuration
EXPAPP_PORT=5000

# JWT Configuration
EXPAPP_JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
EXPAPP_JWT_LIFETIME=7d

# Mobile App Security
MOBILE_APP_API_KEY=your_mobile_api_key_here

# SMS Service (2Factor)
SMS_SECRET_KEY=your_2factor_sms_secret_key
OTP_TEMPLATE_NAME=YourTemplateName

# =================================
# PAYMENT GATEWAY CONFIGURATION
# =================================

# Active Payment Gateway
PAYMENT_GATEWAY=phonepe

# Allow both gateways
ALLOW_RAZORPAY=true
ALLOW_PHONEPE=true

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PhonePe Configuration
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USER=webhook_user
PHONEPE_WEBHOOK_PASS=webhook_password
PHONEPE_WEBHOOK_STRICT=false

# AWS S3 Configuration
AWS_SECRET_ID=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=ap-south-1

# =================================
# LOGGING & DEBUG
# =================================

LOG_TO_FILE=true
LOG_LEVEL=info
RATE_LIMIT_ENABLED=false
DEBUG=false
