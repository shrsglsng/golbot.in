# =================================
# SERVER CONFIGURATION - TEMPLATE
# Copy this file to .env.development or .env.production and fill in your values
# =================================

# Environment
NODE_ENV=development

# Database Configuration
EXPAPP_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/database_name
EXPAPP_MONGO_LOCAL_URL=mongodb+srv://username:password@cluster.mongodb.net/local_database

# Server Configuration
EXPAPP_PORT=5000

# JWT Configuration
EXPAPP_JWT_SECRET=your-jwt-secret-min-32-chars-long
EXPAPP_JWT_LIFETIME=7d

# Mobile App Security
MOBILE_APP_API_KEY=your_mobile_api_key

# SMS Service (2Factor)
SMS_SECRET_KEY=your_sms_secret_key
OTP_TEMPLATE_NAME=YourTemplateName

# =================================
# PAYMENT GATEWAY CONFIGURATION
# =================================

# Active Payment Gateway (razorpay | phonepe)
PAYMENT_GATEWAY=phonepe

# Allow both gateways (for fallback)
ALLOW_RAZORPAY=true
ALLOW_PHONEPE=true

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PhonePe Configuration
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_VERSION=1
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_WEBHOOK_USER=your_webhook_user
PHONEPE_WEBHOOK_PASS=your_webhook_password
PHONEPE_WEBHOOK_STRICT=false
PHONEPE_REDIRECT_URL=http://localhost:3000/payment/redirect

# AWS S3 Configuration
AWS_SECRET_ID=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=ap-south-1

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
USER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

# Logging Configuration
LOG_TO_FILE=true
LOG_LEVEL=error

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=true

# Development
DEBUG=false
