# =================================
# GOLBOT SERVER CONFIGURATION
# =================================
# Available environments: local, stage, prod
# Use: npm run start:local / npm run start:stage / npm run start:prod

# =================================
# ENVIRONMENT-SPECIFIC CONFIGURATION
# =================================
# These settings change between local/stage/prod

# Environment
NODE_ENV=local

# Frontend URLs (used to auto-construct CORS, payment redirects, and QR codes)
# local: http://localhost:3000 / http://localhost:3001
# stage: https://stage.golbot.in / https://admin-stage.golbot.in
# prod:  https://golbot.in / https://admin.golbot.in
USER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

# Optional: Additional CORS origins (comma-separated)
# Example: CORS_ORIGIN=https://example.com,https://another-domain.com
# CORS_ORIGIN=

# =================================
# SERVER CONFIGURATION
# =================================

# Database Configuration
# local: mongodb+srv://user:pass@cluster.mongodb.net/local
# stage: mongodb+srv://user:pass@cluster.mongodb.net/stage
# prod:  mongodb+srv://user:pass@cluster.mongodb.net/prod
EXPAPP_MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/database

# Server Configuration
EXPAPP_PORT=5000

# JWT Configuration
EXPAPP_JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
EXPAPP_JWT_LIFETIME=7d

# Mobile App Security
MOBILE_APP_API_KEY=your_mobile_api_key_here

# SMS Service (StartMessaging)
STARTMESSAGING_API_KEY=sm_live_your_api_key_here
OTP_TEMPLATE_ID=TemplateId

# =================================
# PAYMENT GATEWAY CONFIGURATION
# =================================

# Active Payment Gateway
PAYMENT_GATEWAY=phonepe

# Allow both gateways
ALLOW_RAZORPAY=true
ALLOW_PHONEPE=true

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PhonePe Configuration
# PHONEPE_ENVIRONMENT: 'test' for sandbox or 'production' for live
PHONEPE_ENVIRONMENT=test

# Sandbox/Test credentials
PHONEPE_TEST_CLIENT_ID=your_test_client_id
PHONEPE_TEST_CLIENT_SECRET=your_test_client_secret

# Production credentials (uncomment when going live)
# PHONEPE_PROD_CLIENT_ID=your_production_client_id
# PHONEPE_PROD_CLIENT_SECRET=your_production_client_secret

PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USER=webhook_user
PHONEPE_WEBHOOK_PASS=webhook_password
PHONEPE_WEBHOOK_STRICT=false

# =================================
# REPORT EMAIL CONFIGURATION
# =================================

# Support email for receiving food issue reports
REPORT_SUPPORT_EMAIL=rakareve@gmail.com

# AWS S3 Configuration
AWS_SECRET_ID=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=ap-south-1

# =================================
# LOGGING & DEBUG
# =================================

LOG_TO_FILE=true
LOG_LEVEL=info
RATE_LIMIT_ENABLED=false
DEBUG=false

# =================================
# DEMO MODE CONFIGURATION
# =================================
# Demo mode allows client presentations without requiring real phone numbers
# Enable for local/stage environments, disable for production

# Enable/disable demo mode
DEMO_MODE=true

# Demo credentials (used when DEMO_MODE=true)
DEMO_PHONE=9876543210
DEMO_OTP=123456
