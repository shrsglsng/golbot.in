{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "npm i && node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "start:local": "node -r dotenv/config server.js dotenv_config_path=.env.local",
    "start:stage": "node -r dotenv/config server.js dotenv_config_path=.env.stage",
    "start:prod": "node -r dotenv/config server.js dotenv_config_path=.env.prod",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "echo \"Linting not configured\"",
    "format": "echo \"Formatting not configured\"",
    "logs": "tail -f logs/$(date +%Y-%m-%d).log",
    "logs:error": "grep -i error logs/$(date +%Y-%m-%d).log",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "health": "curl -s http://localhost:5000/health | jq",
    "env:local": "node scripts/env-setup.js local",
    "env:stage": "node scripts/env-setup.js stage",
    "env:prod": "node scripts/env-setup.js prod",
    "env:validate": "node scripts/validate-env.js",
    "admin:create": "node scripts/create-admin.js",
    "admin:list": "node scripts/enable-admin.js",
    "seed:items": "node scripts/seedItems.js",
    "seed:items:local": "node -r dotenv/config scripts/seedItems.js dotenv_config_path=.env.local",
    "seed:items:stage": "node -r dotenv/config scripts/seedItems.js dotenv_config_path=.env.stage",
    "seed:items:prod": "node -r dotenv/config scripts/seedItems.js dotenv_config_path=.env.prod",
    "clear:orders": "node scripts/clearOrders.js",
    "clear:orders:local": "node -r dotenv/config scripts/clearOrders.js dotenv_config_path=.env.local",
    "clear:orders:stage": "node -r dotenv/config scripts/clearOrders.js dotenv_config_path=.env.stage",
    "clear:orders:prod": "node -r dotenv/config scripts/clearOrders.js dotenv_config_path=.env.prod",
    "migrate:reports-seen": "node scripts/migrateReportsSeen.js",
    "migrate:reports-seen:local": "node -r dotenv/config scripts/migrateReportsSeen.js dotenv_config_path=.env.local",
    "migrate:reports-seen:stage": "node -r dotenv/config scripts/migrateReportsSeen.js dotenv_config_path=.env.stage",
    "migrate:reports-seen:prod": "node -r dotenv/config scripts/migrateReportsSeen.js dotenv_config_path=.env.prod",
    "pm2:local": "npm run env:local && pm2 start ecosystem.config.cjs --only golbot-api-local",
    "pm2:stage": "npm run env:stage && pm2 start ecosystem.config.cjs --only golbot-api-stage",
    "pm2:prod": "npm run env:prod && pm2 start ecosystem.config.cjs --only golbot-api-prod",
    "pm2:start:local": "pm2 start ecosystem.config.cjs --only golbot-api-local",
    "pm2:start:stage": "pm2 start ecosystem.config.cjs --only golbot-api-stage",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --only golbot-api-prod",
    "pm2:stop:local": "pm2 stop golbot-api-local",
    "pm2:stop:stage": "pm2 stop golbot-api-stage",
    "pm2:stop:prod": "pm2 stop golbot-api-prod",
    "pm2:restart:local": "pm2 restart golbot-api-local",
    "pm2:restart:stage": "pm2 restart golbot-api-stage",
    "pm2:restart:prod": "pm2 restart golbot-api-prod",
    "pm2:reload:local": "pm2 reload golbot-api-local",
    "pm2:reload:stage": "pm2 reload golbot-api-stage",
    "pm2:reload:prod": "pm2 reload golbot-api-prod",
    "pm2:delete:local": "pm2 delete golbot-api-local",
    "pm2:delete:stage": "pm2 delete golbot-api-stage",
    "pm2:delete:prod": "pm2 delete golbot-api-prod",
    "pm2:logs:local": "pm2 logs golbot-api-local",
    "pm2:logs:stage": "pm2 logs golbot-api-stage",
    "pm2:logs:prod": "pm2 logs golbot-api-prod",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.445.0",
    "axios": "^1.3.6",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.0",
    "cashfree-pg-sdk-nodejs": "^2.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^7.0.0",
    "http-status-codes": "^2.2.0",
    "js-sha256": "^0.11.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.3.1",
    "multer": "^1.4.4",
    "multer-s3": "^3.0.1",
    "node-fetch": "^3.3.2",
    "razorpay": "^2.9.6",
    "server": "file:",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "morgan": "^1.10.0",
    "nodemon": "^2.0.20"
  }
}
