{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "npm i && node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "dev:local": "node -r dotenv/config server.js dotenv_config_path=.env.development",
    "start:production": "node -r dotenv/config server.js dotenv_config_path=.env.production",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "echo \"Linting not configured\"",
    "format": "echo \"Formatting not configured\"",
    "logs": "tail -f logs/$(date +%Y-%m-%d).log",
    "logs:error": "grep -i error logs/$(date +%Y-%m-%d).log",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "health": "curl -s http://localhost:5000/health | jq",
    "env:dev": "node scripts/env-setup.js development",
    "env:prod": "node scripts/env-setup.js production",
    "env:validate": "node scripts/validate-env.js",
    "pm2:dev": "npm run env:dev && pm2 start ecosystem.config.cjs --only golbot-api-dev",
    "pm2:prod": "npm run env:prod && pm2 start ecosystem.config.cjs --only golbot-api-prod",
    "pm2:start:dev": "pm2 start ecosystem.config.cjs --only golbot-api-dev",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --only golbot-api-prod",
    "pm2:stop:dev": "pm2 stop golbot-api-dev",
    "pm2:stop:prod": "pm2 stop golbot-api-prod",
    "pm2:restart:dev": "pm2 restart golbot-api-dev",
    "pm2:restart:prod": "pm2 restart golbot-api-prod",
    "pm2:reload:dev": "pm2 reload golbot-api-dev",
    "pm2:reload:prod": "pm2 reload golbot-api-prod",
    "pm2:delete:dev": "pm2 delete golbot-api-dev",
    "pm2:delete:prod": "pm2 delete golbot-api-prod",
    "pm2:logs:dev": "pm2 logs golbot-api-dev",
    "pm2:logs:prod": "pm2 logs golbot-api-prod",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.445.0",
    "axios": "^1.3.6",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.0",
    "cashfree-pg-sdk-nodejs": "^2.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^7.0.0",
    "http-status-codes": "^2.2.0",
    "js-sha256": "^0.11.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.3.1",
    "multer": "^1.4.4",
    "multer-s3": "^3.0.1",
    "node-fetch": "^3.3.2",
    "razorpay": "^2.9.6",
    "server": "file:",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "morgan": "^1.10.0",
    "nodemon": "^2.0.20"
  }
}
