# =================================
# USER WEB FRONTEND - TEMPLATE
# Copy this file to .env.development or .env.production and fill in your values
# =================================

# API Endpoints
NEXT_PUBLIC_SERVER_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# Payment Gateway Configuration
NEXT_PUBLIC_PAYMENT_GATEWAY=phonepe

# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# PhonePe Configuration
NEXT_PUBLIC_PHONEPE_ENV=sandbox

# Feature Flags
NEXT_PUBLIC_ENABLE_DEBUG=false

# Demo Mode Configuration
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_PHONE=9876543210
NEXT_PUBLIC_DEMO_OTP=123456
EOF